LOCAL_LLM_API_KEY=

# Optional QQ entry; configure only when explicitly starting --mode qq.
QQ_APP_ID=
QQ_APP_SECRET=
SENDER_EMAIL=
EMAIL_AUTH_CODE=
RECEIVER_EMAIL=
